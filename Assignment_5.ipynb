    "import re\n",
    "String = input(\"Enter a string: \")\n",
    "pattern = r'^[a-zA-Z0-9]+$'\n",
    "if re.match(pattern,String):\n",
    "    print(\"Valid! String contains ONLY a-z, A-Z, and 0-9.\")\n",
    "else:\n",
    "    print(\"Invalid! String contains spaces or special characters.\")"
